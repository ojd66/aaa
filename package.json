{
  "name": "chat-sdk-form-bot",
  "description": "Chat SDK Form Submission bot",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/lib/local.ts",
    "build": "tsc",
    "test": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "check": "ultracite check --type-aware --type-check",
    "fix": "ultracite fix --type-aware --type-check",
    "validate": "pnpm check && pnpm type-check && pnpm test"
  },
  "dependencies": {
    "@chat-adapter/slack": "^4.20.2",
    "@chat-adapter/state-redis": "^4.20.2",
    "chat": "^4.20.2",
    "hono": "^4.12.8",
    "resend": "^6.9.4"
  },
  "devDependencies": {
    "@hono/node-server": "^1.19.11",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "oxlint-tsgolint": "^0.17.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "ultracite": "7.3.2",
    "vite": "^8.0.1",
    "vitest": "^4.1.0"
  }
}
